func timer_out(this_group, next_group) {
  var delay = (this_group.value / 2) + (next_group.value / 2)
  var spawn_location = random_degree()
  previous_group.spawn(spawn_location)
  select_new_group()
}

func select_new_group() {
  this_group = next_group
  next_group = possible_enemies.pick_rand
}

